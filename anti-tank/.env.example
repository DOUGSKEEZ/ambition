# anti-tank service — interview prep ("so I don't TANK the interview").
# Owns prep_questions + checklist_templates + checklist_template_items + opportunity_checklist_items
# + stories + question_stories + opportunity_briefs + prep_packs; READS the other apps' tables
# (opportunities/opportunity_contacts/companies/people/company_intel/job_postings) — never writes them.
PORT=7706

# Shared database — the same Postgres DB Sniper + Medic + Engineer + SpecOps + UAV + Commander use.
DATABASE_URL=postgres://samwise:samwise123@localhost:5432/sniper

# Sniper's media dir (company logos / contact photos) for briefing cards.
SNIPER_MEDIA_DIR=../sniper/media

# --- AI: LOCAL ONLY, by design ---
# This app is KEYLESS — there is deliberately no ANTHROPIC_API_KEY and no Claude code path.
# Prep-pack content (question banks / checklists / angle) is generated by Claude Code in the
# terminal and imported via POST /api/opportunities/:id/pack. The one runtime model call is the
# optional qwen3 drill "banter" (interviewer pushback), which degrades to a no-op when unreachable.
LOCAL_LLM_URL=http://192.168.20.21:8080/v1/chat/completions
LOCAL_LLM_MODEL=qwen3-30b
LOCAL_LLM_FALLBACK_URL=http://192.168.20.21:8082/v1/chat/completions
