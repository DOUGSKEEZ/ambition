# commander service — strategic company-intelligence dashboard.
# Owns feed_items + feed_digests + company_intel + sitreps; READS the other apps' tables
# (people/opportunities/job_postings) for the SITREP rollup — never writes them.
PORT=7705

# Shared database — the same Postgres DB Sniper + Medic + Engineer + SpecOps + UAV use.
DATABASE_URL=postgres://samwise:samwise123@localhost:5432/sniper

# Sniper's media dir (company logos / contact photos), if displayed.
SNIPER_MEDIA_DIR=../sniper/media

# Timezone for date grouping / the daily pipeline.
REPORT_TZ=America/Denver

# --- Feed / digest tuning ---
# How far back a per-feed AI digest looks, and how many recent items it summarizes.
FEED_LOOKBACK_DAYS=14
DIGEST_ITEM_COUNT=6
# "Going cold" threshold (days since last outreach touch) used by the SITREP rollup — matches Medic.
COLD_DAYS=7

# --- AI (per the suite rule: default to the LOCAL qwen3 model; Claude is opt-in only) ---
# AI_PROVIDER selects the default: 'local' (qwen3) or 'anthropic' (Claude). NEVER set to anthropic
# without intending real Claude API calls — leave ANTHROPIC_API_KEY blank to hard-disable Claude.
AI_PROVIDER=local
LOCAL_LLM_URL=http://192.168.20.21:8080/v1/chat/completions
LOCAL_LLM_MODEL=qwen3-30b
LOCAL_LLM_FALLBACK_URL=http://192.168.20.21:8082/v1/chat/completions
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
