# engineer service — analytics & metrics over the shared Sniper/Medic database.
# Read-only: engineer owns no tables, it aggregates what Sniper and Medic write.
PORT=7702

# Shared database — the same Postgres DB Sniper + Medic use.
DATABASE_URL=postgres://samwise:samwise123@localhost:5432/sniper

# Timezone for day/week bucketing — anchors charts to Doug's local day regardless of where
# Postgres runs. IANA name (e.g. America/Denver, America/New_York).
REPORT_TZ=America/Denver
