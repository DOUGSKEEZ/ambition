# meddic service
PORT=7701

# Shared database — the same Postgres DB Sniper writes to (reads companies + active people,
# owns the campaign tables and the people tracker columns).
DATABASE_URL=postgres://samwise:samwise123@localhost:5432/sniper

# Sniper's media dir (same host) so contact photos render in meddic's UI.
SNIPER_MEDIA_DIR=../sniper/media

# Drafting provider: 'local' (qwen3) or 'anthropic' (Claude). Switchable per /draft call.
# Default 'anthropic' for best draft quality (follows the no-fabrication rules reliably);
# falls back to local automatically if ANTHROPIC_API_KEY is unset.
DRAFT_PROVIDER=anthropic

# Local LLM (OpenAI-compatible). Cross-VLAN from Samwise.
LOCAL_LLM_URL=http://192.168.20.21:8080/v1/chat/completions
LOCAL_LLM_MODEL=qwen3-30b
LOCAL_LLM_FALLBACK_URL=http://192.168.20.21:8082/v1/chat/completions

# Claude Messages API (opt-in). Set the key to enable provider=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Doug's voice/positioning markdown, fed into every draft.
CONTEXT_DIR=./context

# Work-queue "going cold" threshold (days without an action).
COLD_DAYS=7
