# Sniper service
PORT=7700
DATABASE_URL=postgres://samwise:samwise123@localhost:5432/sniper

# AI synthesis provider for ai_summary/ai_ins: 'anthropic' (Claude) or 'local' (qwen3).
# Default anthropic for quality; falls back to local automatically if the key is unset.
AI_PROVIDER=local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Local LLM fallback (OpenAI-compatible chat/completions). Cross-VLAN from Samwise.
LLM_URL=http://192.168.20.21:8080/v1/chat/completions
LLM_MODEL=qwen3-30b
LLM_FALLBACK_URL=http://192.168.20.21:8082/v1/chat/completions

# Storage (absolute paths or relative to project root)
MEDIA_DIR=./media
INBOX_DIR=./inbox
RAW_DIR=./raw
