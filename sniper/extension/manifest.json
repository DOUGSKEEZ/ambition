{
  "manifest_version": 3,
  "name": "Sniper Capture",
  "version": "1.0.0",
  "description": "Capture the LinkedIn profile you're viewing and send it to Sniper.",
  "permissions": ["activeTab", "scripting", "downloads"],
  "host_permissions": [
    "http://192.168.10.21:7700/*",
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Sniper Capture",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
