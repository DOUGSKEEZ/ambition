# specops service — opportunity tracking over the shared Sniper/Medic database.
# Owns the opportunities + opportunity_contacts tables; references companies + people.
PORT=7703

# Shared database — the same Postgres DB Sniper + Medic + Engineer use.
DATABASE_URL=postgres://samwise:samwise123@localhost:5432/sniper

# Sniper's media dir (same host) so contact photos render on opportunity cards.
SNIPER_MEDIA_DIR=../sniper/media
