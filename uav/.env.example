# uav service — job-posting radar over foundational-model companies' job boards.
# Owns the job_postings + uav_events tables; references no other app's tables.
PORT=7704

# Shared database — the same Postgres DB Sniper + Medic + Engineer + SpecOps use.
DATABASE_URL=postgres://samwise:samwise123@localhost:5432/sniper

# --- Re-apply cadence (the aging timer thresholds, in days) ---
# A role you've applied to goes "due" (amber) at SOFT days and "overdue" (red) at HARD days,
# so you can re-apply every 7-14 days to stay fresh in the pool. The daily digest nudges you
# about every applied+open role past REAPPLY_SOFT_DAYS.
REAPPLY_SOFT_DAYS=7
REAPPLY_HARD_DAYS=14

# --- Email (nodemailer, generic SMTP) ---
# Defaults target Microsoft 365 (dougmcafee.com is on Outlook/Exchange). To use Gmail instead,
# set SMTP_HOST=smtp.gmail.com and SMTP_USER/PASS to a Gmail address + app password.
# Leave SMTP_USER/SMTP_PASS blank to disable email (the pipeline still runs + records the DB diff).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=UAV Radar <doug@dougmcafee.com>
SMTP_TO=doug@dougmcafee.com
